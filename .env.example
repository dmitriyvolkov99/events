# Только для production: владелец образов в GHCR (GitHub-логин или организация, строчными буквами)
GHCR_OWNER=your-github-username
# Версия образов для отката (полный SHA коммита), по умолчанию latest
# IMAGE_TAG=

# SQL Server: от 8 символов, заглавные и строчные буквы, цифры или символы
DB_PASSWORD=your-strong-sql-server-password
# Секрет подписи JWT: случайная строка от 64 символов
TOKEN_KEY=your-token-key

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=